# Frontend Worker runtime env (production)
REACT_APP_API_BASE_URL=/api

# API runtime (merged backend into frontend worker)
FRONTEND_URL=https://frontend.example.com
POST_LOGOUT_REDIRECT_URI=https://frontend.example.com/
CORS_ALLOWED_ORIGINS=https://frontend.example.com
COOKIE_SECURE=true
AUTH_PASSWORD_SALT=replace-with-prod-random-salt
DEFAULT_LOCAL_ADMIN_EMAIL=admin@gmail.com
DEFAULT_LOCAL_ADMIN_PASSWORD=replace-or-disable-in-prod
DEFAULT_FROM_EMAIL=no-reply@example.com

# Diagnostics executor bridge
DIAGNOSTICS_EXECUTOR_URL=https://diagnostics.example.com
DIAGNOSTICS_EXECUTOR_TOKEN=replace-with-prod-shared-executor-token

# Azure SSO (optional)
AZURE_TENANT_ID=replace-with-prod-tenant-id
AZURE_CLIENT_ID=replace-with-prod-client-id
AZURE_CLIENT_SECRET=replace-with-prod-client-secret
AZURE_REDIRECT_URI=https://frontend.example.com/api/oauth2/callback/
AZURE_SCOPES=openid profile email offline_access User.Read
