# Frontend Worker runtime env (development)
REACT_APP_API_BASE_URL=/api

# API runtime (merged backend into frontend worker)
FRONTEND_URL=http://127.0.0.1:8788
POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:8788/
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8788
COOKIE_SECURE=false
AUTH_PASSWORD_SALT=replace-with-dev-random-salt
DEFAULT_LOCAL_ADMIN_EMAIL=admin@gmail.com
DEFAULT_LOCAL_ADMIN_PASSWORD=admin@gmail.com
DEFAULT_FROM_EMAIL=no-reply@example.com

# Diagnostics executor bridge
DIAGNOSTICS_EXECUTOR_URL=http://127.0.0.1:8000
DIAGNOSTICS_EXECUTOR_TOKEN=replace-with-shared-executor-token

# Azure SSO (optional in dev)
AZURE_TENANT_ID=replace-with-dev-tenant-id
AZURE_CLIENT_ID=replace-with-dev-client-id
AZURE_CLIENT_SECRET=replace-with-dev-client-secret
AZURE_REDIRECT_URI=http://127.0.0.1:8788/api/oauth2/callback/
AZURE_SCOPES=openid profile email offline_access User.Read
